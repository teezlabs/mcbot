# Discord bot token (from https://discord.com/developers/applications)
# Leave the three DISCORD_ values empty to run on GameVox only.
DISCORD_TOKEN=your_bot_token_here

# Discord channel ID where MC events are posted and Discord messages are read
DISCORD_CHANNEL_ID=your_channel_id_here

# Webhook URL for the same channel (Settings → Integrations → Webhooks → New Webhook)
DISCORD_WEBHOOK_URL=your_webhook_url_here

# GameVox (optional). Set both to bridge a GameVox channel too, alongside Discord or instead of it.
# Create the bot at https://developers.gamevox.com and turn on Message Content on its Bot tab.
# No webhook: GameVox webhooks can't set the player's name or avatar, so the bot posts itself.
# GAMEVOX_TOKEN=your_gamevox_bot_token
# GAMEVOX_CHANNEL_ID=your_gamevox_channel_id
# Override only to point at a different GameVox host
# GAMEVOX_API=https://app-api.gamevox.com
# GAMEVOX_GATEWAY=wss://gateway.gamevox.com

# Path to the logs DIRECTORY on the HOST machine (mounted read-only into the container).
# Mount the directory, not latest.log directly — bind-mounting the file pins the inode and
# breaks log rotation, so the bot will silently stop seeing new lines after the first rotation.
MC_LOG_HOST_DIR=/path/to/your/minecraft/server/logs

# Path to the Minecraft server folder on the HOST machine (mounted read-only into the container).
# The bot reads death messages from the language files in mods/ and libraries/ so it can detect
# every vanilla and modded death.
MC_SERVER_HOST_DIR=/path/to/your/minecraft/server

# Running WITHOUT Docker: set the full path to latest.log instead (Docker sets this itself)
# MC_LOG_PATH=/path/to/your/minecraft/server/logs/latest.log
# The server folder defaults to the folder above logs/. Set it only if your logs live elsewhere.
# MC_SERVER_DIR=/path/to/your/minecraft/server

# RCON settings (must be enabled in server.properties)
RCON_HOST=host-gateway
RCON_PORT=25575
RCON_PASSWORD=your_rcon_password

# Modpack update checker (optional)
# Get a free API key at https://console.curseforge.com
# Find the project ID on the modpack's CurseForge page (About Project → Project ID)
CURSEFORGE_API_KEY=your_curseforge_api_key
CURSEFORGE_PROJECT_ID=your_project_id
# How often to check for updates in milliseconds (default: 1 hour)
# PACK_UPDATE_INTERVAL_MS=3600000

# Name shown in the bot's status (optional). Defaults to the CurseForge project name, which can be long.
# Works without a CurseForge key.
# PACK_NAME=My Modpack

# Let @Name in Minecraft chat ping Discord members who can see the channel and mentionable roles (optional).
# Turn on the Server Members Intent in the developer portal first. @everyone and @here never ping.
# With the server mod in mod/ installed, players also get the names as Tab completions in chat.
# DISCORD_MENTIONS=true

# Avatar image for Minecraft messages (optional). {id} becomes the player's UUID, or their name
# if the UUID isn't known yet. Change it if the default service stops working.
# AVATAR_URL=https://minotar.net/helm/{id}/64.png
